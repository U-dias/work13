<% if user_signed_in? %>
<div>
<%= form_with url: search_path, local: true, method: :get do |f| %>
  <%= f.text_field :keyword, placeholder: "検索する", class: "search-input" %>
  <%= f.select :range, options_for_select([['Room']]) %>
    <%= f.submit "検索", class: "search-btn", id: "search-icon" %>
  <% end %>
</div>
<% end %>