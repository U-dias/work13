<h1>Rooms#new</h1>
<p>Find me in app/views/rooms/new.html.erb</p>

<div class="container">
    <div class="card mt-4">
        <div class="card-body">
            <h4 class="mt-4 mb-4"><b>部屋の新規登録</b></h4>
            <%= form_for @room, multipart: true do |f| %>
                <div class="row mb-4">            
                    <div class="col-md-4">
                        <div class="mb-2">
                            <label>施設名</label>
                            <%= f.text_field :r_name,
                                id: "r_name", class: "form-control" %>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="mb-2">
                            <label>写真</label>
                            <%= image_tag room_url(@room), :size => '150x100', class: "img-fluid img-thumbnail rounded-pill" %>
                            <h4 style="margin-left: 5.5rem;"></h4>
        
        
                            <button class="btn btn-info text-light w-100" type="button" data-bs-toggle="collapse" data-bs-target="#collapse1" aria-expanded="false" aria-controls="collapse1">
                                <i class="fa-solid fa-cloud-arrow-up"></i>写真アップロード
                            </button>
                            <div class="collapse" id="collapse1">
                            <div class="card card-body">
                            <%= form_for :rooms, url: rooms_url(current_user), action: :update, method: :post do |form|  %>
                                <%= form.file_field :photos, class: "input-group-text", onchange: "this.form.submit();" %>
                                <%= form.submit %>
                                
                                    
                               <% end %>
                            </div>

                        </div>
                    </div>
                </div>
                <div class="row mb-4">          
                    <div class="col-md-4">
                        <div class="mb-2">
                            <label>紹介</label>
                            <%= f.text_area :r_self,
                                id: "r_self", class: "form-control" %>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="mb-2">
                            <label>料金</label>
                            <%= f.text_field :r_price,
                                id: "r_price", class: "form-control" %>
                        </div>
                    </div>
                    <div class="col-md-4">
                     <div class="mb-2">
                            <label>作成日</label>
                            <%= f.date_field :r_create,
                                id: "r_create", class: "form-control" %>
                        </div>
                     </div>
                     <div class="col-md-4">
                      <div class="mb-2">
                            <label>住所</label>
                            <%= f.text_field :r_address,
                                id: "r_address", class: "form-control" %>
                      </div>
                     </div>
                     <div class="col-md-4">
                     <div class="mb-2">
                           <label>宿泊可能人数</label>
                           <%= f.text_field :people,
                               id: "people", class: "form-control" %>
                     </div>
                    </div>
                </div>
                <%= f.submit "登録する", class: "btn btn-danger w-100" %>        
            <% end %>
        </div>
    </div>    
</div>